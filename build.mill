//| mill-version: 1.0.0
//| mill-jvm-opts: ["-Xmx1G"]
package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.util.VcsVersion

val scala213 = "2.13.15"
val scala3 = "3.7.1"

object squery extends ScalaModule, SonatypeCentralPublishModule {
  def artifactName = "squery"
  def pomSettings = buildPomSettings("Squery SQL library")
  def publishVersion = VcsVersion.vcsState().format()
  def scalaVersion = scala3
  def mvnDeps = Seq(
    mvn"com.typesafe.scala-logging::scala-logging:3.9.4",
    mvn"com.github.jsqlparser:jsqlparser:4.7",
    mvn"org.scala-lang.modules::scala-collection-contrib:0.4.0"
  )
  def scalacOptions = Seq("-Ywarn-unused", "-deprecation", "-feature", "-language:implicitConversions")

  object `postgres-jawn` extends ScalaModule, SonatypeCentralPublishModule {
    def artifactName = "squery-postgres-jawn"
    def pomSettings = buildPomSettings("Squery Jawn extension for PostgreSQL")
    def publishVersion = VcsVersion.vcsState().format()
    def scalaVersion = scala3
    def moduleDeps = Seq(squery)
    def mvnDeps = Seq(
      mvn"org.typelevel::jawn-ast::1.6.0"
    )
  }

  object test extends ScalaTests, TestModule.Munit {
    def mvnDeps = Seq(
      mvn"org.scalameta::munit:1.0.0",
      mvn"ch.qos.logback:logback-classic:1.5.7",
      mvn"com.zaxxer:HikariCP:4.0.3",
      mvn"com.h2database:h2:2.3.232",
      mvn"org.testcontainers:testcontainers:1.17.6",
      mvn"org.testcontainers:postgresql:1.17.6",
      mvn"org.postgresql:postgresql:42.7.4",
      mvn"org.testcontainers:mysql:1.19.3",
      mvn"mysql:mysql-connector-java:8.0.33",
      mvn"org.testcontainers:mariadb:1.19.3",
      mvn"org.mariadb.jdbc:mariadb-java-client:3.3.2",
      mvn"org.testcontainers:oracle-free:1.19.3",
      mvn"com.oracle.database.jdbc:ojdbc8:23.3.0.23.09"
    )
  }
}

object generator extends ScalaModule, SonatypeCentralPublishModule {
  def artifactName = "squery-generator"
  def pomSettings = buildPomSettings("Squery generator core")
  def publishVersion = VcsVersion.vcsState().format()
  def scalaVersion = scala213
  def mvnDeps = Seq(
    mvn"ba.sake::regenesca:0.6.3",
    mvn"com.typesafe.scala-logging::scala-logging:3.9.4",
    mvn"ch.qos.logback:logback-classic:1.5.7",
    mvn"org.apache.commons:commons-text:1.12.0"
  )
}

object cli extends ScalaModule, SonatypeCentralPublishModule {
  def artifactName = "squery-cli"
  def pomSettings = buildPomSettings("Squery generator CLI")
  def publishVersion = VcsVersion.vcsState().format()
  def scalaVersion = scala213
  def moduleDeps = Seq(generator)
  def mvnDeps = Seq(
    mvn"com.lihaoyi::mainargs:0.7.6"
  )
  def mainClass = Some("ba.sake.squery.cli.SqueryMain")
}

def buildPomSettings(desc: String) = PomSettings(
  organization = "ba.sake",
  url = "https://github.com/sake92/squery",
  licenses = Seq(License.Common.Apache2),
  versionControl = VersionControl.github("sake92", "squery"),
  description = desc,
  developers = Seq(
    Developer("sake92", "Sakib Hadžiavdić", "https://sake.ba")
  )
)
